{
  "task_id": "demo-sql-debug-federated-001",
  "base_model": {
    "source": "hf",
    "ref": "Qwen/Qwen2.5-0.5B-Instruct",
    "quantization": "nf4",
    "dtype": "bfloat16"
  },
  "gym": {
    "image_ref": "440hz/sample-sql-gym:latest",
    "port": 8080,
    "cpu_limit": 2.0,
    "memory_limit": "4g"
  },
  "supervisor": {
    "type": "openai_compatible",
    "base_url": "http://host.docker.internal:11434/v1",
    "model": "qwen2.5:7b",
    "rubric": "Score the SQL fix from 0.0 to 1.0. JSON only: {\"score\": <float>, \"reason\": \"...\"}",
    "scoring_mode": "per_step"
  },
  "algorithm": {
    "name": "grpo",
    "num_episodes": 30,
    "learning_rate": 0.00002,
    "lora_rank": 16,
    "lora_alpha": 32,
    "target_modules": ["q_proj", "k_proj", "v_proj", "o_proj"],
    "max_new_tokens": 128,
    "temperature": 0.9,
    "top_p": 0.95,
    "kl_coef": 0.04,
    "batch_size": 1,
    "grad_accum_steps": 4,
    "group_size": 4,
    "save_every": 30
  },
  "output": {
    "destination": "local",
    "local_path": "/var/440hz/output"
  },
  "federation": {
    "enabled": true,
    "mode": "one_shot",
    "aggregator_address": "aggregator:8080",
    "round_id": "demo-sql-debug-round-001",
    "num_examples": 1000,
    "connect_timeout_s": 600,
    "connect_retry_interval_s": 5
  },
  "metadata": {
    "submitted_by": "demo",
    "notes": "Federated demo — 3 clients submit to one aggregator running locally."
  }
}
